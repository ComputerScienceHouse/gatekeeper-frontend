# Base URL of the gatekeeper-mqtt API (no trailing slash) — read at runtime, never baked into the bundle
GATEKEEPER_API_URL=http://localhost:3001

# next-auth session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# CSH SSO OIDC client credentials
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
